# Production Dockerfile for Next.js frontend (multi-stage build)
# Build stage
FROM --platform=linux/arm64 node:20-slim AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package files for dependency installation
COPY package.json pnpm-lock.yaml* ./

# Install dependencies (including devDependencies for build)
RUN pnpm install --frozen-lockfile

# Copy application source
COPY . .

# Set build-time environment variables
ARG NEXT_PUBLIC_BACKEND_API_URL
ENV NEXT_PUBLIC_BACKEND_API_URL=$NEXT_PUBLIC_BACKEND_API_URL

# Build the Next.js application
RUN pnpm build

# Production stage
FROM --platform=linux/arm64 node:20-slim AS runner

WORKDIR /app

# Install pnpm and tsx for running init scripts
RUN npm install -g pnpm tsx

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create a non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy necessary files from builder
# Next.js standalone output structure: .next/standalone contains the entire app
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Copy scripts and necessary source files for init-db
COPY --from=builder --chown=nextjs:nodejs /app/scripts ./scripts
COPY --from=builder --chown=nextjs:nodejs /app/server ./server
COPY --from=builder --chown=nextjs:nodejs /app/types ./types
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/tsconfig.json ./tsconfig.json
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules

# Copy and set up entrypoint script
COPY --chown=nextjs:nodejs docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Set Hugging Face cache directory
ENV HF_HOME=/app/.cache/huggingface

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3001

# Set hostname to 0.0.0.0 for Docker
ENV HOSTNAME="0.0.0.0"
ENV PORT=3001

# Use entrypoint script to wait for services and run init-db
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Start Next.js in production mode
# The standalone output creates a server.js in the root
CMD ["node", "server.js"]

